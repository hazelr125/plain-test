# Copy this file to .env and fill it in. Uncomment ONE provider block.

# --- Ollama Cloud (default here) ---
# Key: https://ollama.com/settings/keys
LLM_PROVIDER=ollama
OLLAMA_API_KEY=your-ollama-cloud-key
LLM_MODEL=gpt-oss:120b          # hosted ids have no "-cloud" suffix; kimi-k2.6 also works

# --- Local Ollama (signed in, offloads cloud models) ---
# LLM_PROVIDER=openai
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=x
# LLM_MODEL=gpt-oss:120b-cloud   # locally, cloud models carry the -cloud suffix

# --- Anthropic ---
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your-key-here
# LLM_MODEL=claude-haiku-5-5

# --- Any other OpenAI-compatible API (Gemini, Groq, ...) ---
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your-key-here
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=your-model
